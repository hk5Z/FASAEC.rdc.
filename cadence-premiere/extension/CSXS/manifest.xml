<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cadence – manifeste CEP pour Adobe Premiere Pro 2023 (23.x, hôte PPRO).
  Premiere Pro 23.x n'accepte pas les plug-ins UXP (UXP arrive avec Premiere 25.6) : extension CEP.
  CEP 11 : documenté par Adobe pour Premiere 15.4 et suivantes ; CEP 12 seulement à partir de Premiere 25.0.
  Schéma : ExtensionManifest_v_7_0.xsd (Adobe indique qu'il reste valable après CEP 7).
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="fr.cadence.montage" ExtensionBundleVersion="0.2.0"
  ExtensionBundleName="Cadence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="fr.cadence.montage.panel" Version="0.2.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- Premiere Pro 2023 uniquement (23.0 à 23.6.x). Élargir la plage en connaissance de cause. -->
      <Host Name="PPRO" Version="[23.0,23.99]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="fr.cadence.montage.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Cadence – Montage rapide</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>360</Width>
            </Size>
            <MaxSize>
              <Height>2400</Height>
              <Width>1600</Width>
            </MaxSize>
            <MinSize>
              <Height>320</Height>
              <Width>240</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
